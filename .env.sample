# =============================================
# freee APIアプリ設定（サンプル）
# =============================================
# このファイルをコピーして .env にリネームし、各値を埋めてください
# ※ .env は絶対にGitにコミットしないこと（.gitignoreで除外済）
# ※ 各値は freeeのアプリ管理画面で確認・取得できる

# freeeアプリのクライアントID
CLIENT_ID=ここにClient_IDを貼り付ける

# freeeアプリのクライアントシークレット
CLIENT_SECRET=ここにClient_Secretを貼り付ける

# 認証後のリダイレクト先URL（freeeアプリ設定と一致させること）
# ローカル開発時: http://localhost:8501
# Streamlit Cloud等の本番環境: https://<your-app>.streamlit.app
REDIRECT_URI=http://localhost:8501
